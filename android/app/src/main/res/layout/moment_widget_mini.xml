<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="8dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical">
<LinearLayout android:id="@+id/streak_group" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical"><ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_flame" android:tint="@color/widget_accent" android:importantForAccessibility="no"/><TextView android:id="@+id/count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:fontFamily="serif" android:textSize="26sp" android:textColor="@color/widget_ink" android:includeFontPadding="false"/></LinearLayout>
<TextView android:id="@+id/plain_group" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:visibility="gone" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/widget_ink" android:gravity="center_vertical" android:minHeight="44dp"/>
<LinearLayout android:id="@+id/tile_text" android:layout_width="44dp" android:layout_height="44dp" android:layout_weight="0"  android:orientation="vertical" android:gravity="center" android:background="@drawable/tile_text" android:contentDescription="@string/widget_new_text" android:minHeight="44dp"><ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_text" android:tint="@color/type_text" android:importantForAccessibility="no"/></LinearLayout>
</LinearLayout>
</FrameLayout>
