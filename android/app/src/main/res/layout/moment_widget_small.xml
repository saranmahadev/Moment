<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="8dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
<LinearLayout android:id="@+id/streak_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="30dp"><ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_flame" android:tint="@color/widget_accent" android:importantForAccessibility="no"/><TextView android:id="@+id/count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:fontFamily="serif" android:textSize="28sp" android:textColor="@color/widget_ink" android:includeFontPadding="false"/><FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="0dp"/><TextView android:id="@+id/state" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="9dp" android:paddingEnd="9dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/widget_on_ink" android:background="@drawable/pill_solid" /></LinearLayout>
<TextView android:id="@+id/plain_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/widget_ink" android:gravity="center_vertical" android:minHeight="44dp"/>
<FrameLayout android:layout_width="match_parent" android:layout_height="4dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal"><LinearLayout android:id="@+id/tile_text" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"  android:orientation="vertical" android:gravity="center" android:background="@drawable/tile_text" android:contentDescription="@string/widget_new_text" android:minHeight="44dp"><ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_text" android:tint="@color/type_text" android:importantForAccessibility="no"/></LinearLayout><FrameLayout android:layout_width="6dp" android:layout_height="match_parent"/><LinearLayout android:id="@+id/tile_emoji" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"  android:orientation="vertical" android:gravity="center" android:background="@drawable/tile_emoji" android:contentDescription="@string/widget_new_emoji" android:minHeight="44dp"><ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_emoji" android:tint="@color/type_emoji" android:importantForAccessibility="no"/></LinearLayout><FrameLayout android:layout_width="6dp" android:layout_height="match_parent"/><LinearLayout android:id="@+id/tile_photo" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"  android:orientation="vertical" android:gravity="center" android:background="@drawable/tile_photo" android:contentDescription="@string/widget_new_photo" android:minHeight="44dp"><ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_photo" android:tint="@color/type_photo" android:importantForAccessibility="no"/></LinearLayout></LinearLayout>
<FrameLayout android:layout_width="match_parent" android:layout_height="4dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal"><LinearLayout android:id="@+id/tile_video" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"  android:orientation="vertical" android:gravity="center" android:background="@drawable/tile_video" android:contentDescription="@string/widget_new_video" android:minHeight="44dp"><ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_video" android:tint="@color/type_video" android:importantForAccessibility="no"/></LinearLayout><FrameLayout android:layout_width="6dp" android:layout_height="match_parent"/><LinearLayout android:id="@+id/tile_audio" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"  android:orientation="vertical" android:gravity="center" android:background="@drawable/tile_audio" android:contentDescription="@string/widget_new_audio" android:minHeight="44dp"><ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_audio" android:tint="@color/type_audio" android:importantForAccessibility="no"/></LinearLayout><FrameLayout android:layout_width="6dp" android:layout_height="match_parent"/><LinearLayout android:id="@+id/tile_location" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"  android:orientation="vertical" android:gravity="center" android:background="@drawable/tile_location" android:contentDescription="@string/widget_new_location" android:minHeight="44dp"><ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_location" android:tint="@color/type_location" android:importantForAccessibility="no"/></LinearLayout></LinearLayout>
</LinearLayout>
</FrameLayout>
