# Flutter / Dart
.dart_tool/
.packages
.pub-cache/
.flutter-plugins
.flutter-plugins-dependencies
build/
coverage/
pubspec.lock.bak

# Generated code (CI and developers run build_runner)
*.g.dart
*.drift.dart

# IDE
.idea/
*.iml
.vscode/
.DS_Store

# Android signing (never commit)
android/key.properties
*.jks
*.keystore

# Local data
*.sqlite
*.db
*.moment

# Images flutter_test writes when a golden does not match.
**/failures/

# The upgrade matrix's fixtures: databases and backups made by each
# released version from made-up logs (tool/fixtures/make_fixtures.sh).
# Nothing personal; they must be committed for test/upgrade/ to run.
!test/fixtures/releases/**/*.db
!test/fixtures/releases/**/*.moment
